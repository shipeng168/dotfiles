clear
neofetch -L

alias ..='cd ..'
alias ...='cd ../../'
alias da='du -csh'
alias dad='da *|grep -v K|grep -v ^0|sort -n'
alias f='file -b'
alias ls='ls --color=auto'
alias l='ls -ACF'
alias l.='ls -dlh .*'
alias ll='ls -lth'
alias la='ls -ASlh'
alias lf='ls -Alh|grep ^\-'
alias lsd='ls -Alh|grep ^d'
alias grep='grep --color=auto'
alias pv='pv -qL'
alias md='mkdir -p'
alias rd='rmdir'
alias matrix='cmatrix -b -u 6'
alias ss4='ss -ant4'
alias bx='busybox'

#usr=$PREFIX
#HISTTIMEFORMAT="%Y-%m-%d/%H:%M:%S "
#PATH="$PATH:/system/bin"
#export TZ="CST-8"
