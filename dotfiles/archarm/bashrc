title() { echo -en "\033]0;$*\007";}

cl() {
	if [[ $1 == "" ]]
	then
		cd ~ && ll
	else
		cd "$1" && ll
	fi
}
del() { mv "$@" ~/Trash >/dev/null 2>&1;}
